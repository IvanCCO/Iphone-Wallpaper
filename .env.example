# Copie para .env (ignorado pelo git). Na Vercel, cadastre como Environment Variables.

# --- Autenticação do endpoint (obrigatório) ---
# Gere com: openssl rand -hex 32   (mínimo 24 caracteres)
# Use API_TOKENS=tokenNovo,tokenAntigo para rotacionar sem downtime.
API_TOKEN=

# --- Notion (obrigatório) ---
# Crie uma integração interna em https://www.notion.so/profile/integrations
# Capacidades: SOMENTE "Read content". Depois compartilhe o database com a integração (••• > Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Opcional ---
# NOTION_DATA_SOURCE_ID=            # pula a descoberta do data source
# NOTION_API_VERSION=2025-09-03
# NOTION_PROP_TITLE=Name            # nomes das propriedades; use "-" para desligar uma opcional
# NOTION_PROP_STATUS=Status         # tipos aceitos: status, select, checkbox
# NOTION_PROP_DUE=Due               # tipo date
# NOTION_PROP_PRIORITY=Priority     # tipos aceitos: select, status
# NOTION_DONE_STATUSES=Done,Concluído
# NOTION_ACTIVE_STATUSES=À Fazer,Fazendo   # se definido, só estes status entram (ignora Padrões, Feito etc.)
# NOTION_EXCLUDE_TAGS=Leitura       # exclui estas tags (propriedade de NOTION_PROP_PRIORITY)
# NOTION_DATE_FILTER=empty          # 'empty' = só tarefas SEM data; padrão 'any'
# NOTION_SORT_PROP=Tags             # ordena a consulta por esta propriedade (padrão: a de vencimento)
# NOTION_PRIORITY_HIGH=High,Alta
# NOTION_PRIORITY_MEDIUM=Medium,Média
# NOTION_PRIORITY_LOW=Low,Baixa
# NOTION_CACHE_TTL_SECONDS=120
# NOTION_TIMEOUT_MS=8000
# TZ_DEFAULT=America/Sao_Paulo
# IMAGE_SAFE_TOP=0.4                # fração da altura onde o conteúdo começa (abaixo do relógio/widgets)
# IMAGE_SAFE_BOTTOM=0.84            # fração onde termina (acima da lanterna/câmera)
# PORT=3000
# HOST=127.0.0.1

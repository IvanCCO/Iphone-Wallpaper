# Copie para .env (ignorado pelo git). Na Vercel, cadastre as MESMAS 3 variáveis em Environment Variables.
# Todo o resto (propriedades, filtros, cache, imagem) fica em config/notion.json.

# Senha do endpoint. Gere com: openssl rand -hex 32   (mínimo 24 caracteres)
# Para rotacionar sem downtime, use API_TOKENS=novo,antigo no lugar de API_TOKEN.
API_TOKEN=

# Integração interna do Notion (https://www.notion.so/profile/integrations), só "Read content".
# Compartilhe o database com a integração: ••• > Connections.
NOTION_TOKEN=

# Os 32 caracteres da URL do database, antes do ?v=
NOTION_DATABASE_ID=

# Só para rodar localmente (opcional)
# PORT=3000
# HOST=127.0.0.1

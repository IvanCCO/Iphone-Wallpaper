{
  "name": "personal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API pessoal em Hono. Primeiro endpoint: wallpaper do iPhone com tarefas do Notion.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "start": "tsx --env-file-if-exists=.env src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "embed-fonts": "node scripts/embed-fonts.mjs",
    "preview": "tsx scripts/preview.ts",
    "verify": "node scripts/verify.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.19",
    "satori": "^0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.0.0"
}
